<decisions><name>Has_End_User</name><label>Has End User</label><locationX>176</locationX><locationY>900</locationY><defaultConnector><targetReference>Link_Done</targetReference></defaultConnector><defaultConnectorLabel>Other</defaultConnectorLabel><rules><name>End_user_given</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>endUserId</leftValueReference><operator>IsBlank</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions><connector><targetReference>Link_End_User</targetReference></connector><label>End user given</label></rules></decisions>

<description>Checks account number plus registered phone number (exactly 10 digits, last 10 digits of the stored number compared). Both must match the same customer. Refuses when the customer says they are not the account holder. Returns verified, blocked and the customer Id.</description>
<environments>Default</environments>
<formulas><name>phoneDigits</name><dataType>String</dataType><expression>SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!phone}, " ", ""), "-", ""), "(", ""), ")", ""), "+", ""), ".", "")</expression></formulas>

<formulas><name>phoneValid</name><dataType>Boolean</dataType><expression>REGEX({!phoneDigits}, "[0-9]{10}")</expression></formulas>

<formulas><name>phoneLast10</name><dataType>String</dataType><expression>RIGHT({!phoneDigits}, 10)</expression></formulas>

<formulas><name>cleanAccount</name><dataType>String</dataType><expression>TRIM({!accountNumber})</expression></formulas>

<interviewLabel>Verify Customer {!$Flow.CurrentDateTime}</interviewLabel>
<label>Verify Customer</label>
<processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
<processType>AutoLaunchedFlow</processType>
<recordLookups><name>Find_Contact</name><label>Find Contact</label><locationX>176</locationX><locationY>450</locationY><assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound><connector><targetReference>Contact_Found</targetReference></connector><faultConnector><targetReference>Not_Verified</targetReference></faultConnector><filterLogic>and</filterLogic><filters><field>Customer_Account_Number__c</field><operator>EqualTo</operator><value><elementReference>cleanAccount</elementReference></value></filters><filters><field>Phone_Last10__c</field><operator>EqualTo</operator><value><elementReference>phoneLast10</elementReference></value></filters><getFirstRecordOnly>true</getFirstRecordOnly><object>Contact</object><storeOutputAutomatically>true</storeOutputAutomatically></recordLookups>

<recordUpdates><name>Link_End_User</name><label>Link End User</label><locationX>176</locationX><locationY>1050</locationY><connector><targetReference>Link_Done</targetReference></connector><faultConnector><targetReference>Link_Done</targetReference></faultConnector><filterLogic>and</filterLogic><filters><field>Id</field><operator>EqualTo</operator><value><elementReference>endUserId</elementReference></value></filters><inputAssignments><field>ContactId</field><value><elementReference>Find_Contact.Id</elementReference></value></inputAssignments><object>MessagingEndUser</object></recordUpdates>

<runInMode>SystemModeWithoutSharing</runInMode>
<start><locationX>50</locationX><locationY>0</locationY><connector><targetReference>Third_Party_Check</targetReference></connector></start>
<status>Active</status>
<variables><name>accountNumber</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput><description>Customer account number exactly as the customer typed it</description></variables>

<variables><name>phone</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput><description>Registered phone number exactly as the customer typed it. Exactly 10 digits</description></variables>

<variables><name>claimsToBeSomeoneElse</name><dataType>Boolean</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput><description>True if at any point in the conversation the customer said they are not the account holder or are asking about another person. Leave empty or false otherwise</description></variables>

<variables><name>endUserId</name><dataType>String</dataType><isCollection>false</isCollection><isInput>true</isInput><isOutput>false</isOutput><description>Id of the messaging chat user. Filled in by the system from the chat. When the customer is verified the chat user is linked to the verified contact, so a human transfer can be allowed</description></variables>

<variables><name>verified</name><dataType>Boolean</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput><description>True only if the account number and the phone number both match one customer</description></variables>

<variables><name>blocked</name><dataType>Boolean</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput><description>True if verification was refused because the customer is not the account holder</description></variables>

<variables><name>contactId</name><dataType>String</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput><description>Id of the verified customer. Empty if not verified</description></variables>

<variables><name>firstName</name><dataType>String</dataType><isCollection>false</isCollection><isInput>false</isInput><isOutput>true</isOutput><description>First name of the verified customer. Empty if not verified</description></variables>

</Flow>
