<decisions><name>Third_Party_Check</name><label>Third Party Check</label><locationX>176</locationX><locationY>150</locationY><defaultConnector><targetReference>Inputs_Present</targetReference></defaultConnector><defaultConnectorLabel>Other</defaultConnectorLabel><rules><name>Not_the_account_holder</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>claimsToBeSomeoneElse</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions><connector><targetReference>Blocked_Third_Party</targetReference></connector><label>Not the account holder</label></rules></decisions>

