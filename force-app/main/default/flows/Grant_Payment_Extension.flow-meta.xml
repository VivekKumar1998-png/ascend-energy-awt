<decisions><name>Has_Contact</name><label>Has Contact</label><locationX>176</locationX><locationY>150</locationY><defaultConnector><targetReference>Not_Verified_Yet</targetReference></defaultConnector><defaultConnectorLabel>Other</defaultConnectorLabel><rules><name>Contact_given</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>contactId</leftValueReference><operator>IsBlank</operator><rightValue><booleanValue>false</booleanValue></rightValue></conditions><connector><targetReference>Find_Latest_Bill</targetReference></connector><label>Contact given</label></rules></decisions>

<decisions><name>Check_Rules</name><label>Check Rules</label><locationX>176</locationX><locationY>450</locationY><defaultConnector><targetReference>Apply_Extension</targetReference></defaultConnector><defaultConnectorLabel>Other</defaultConnectorLabel><rules><name>Bill_missing</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Find_Latest_Bill</leftValueReference><operator>IsNull</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions><connector><targetReference>No_Bill</targetReference></connector><label>Bill missing</label></rules><rules><name>Is_paid</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Find_Latest_Bill.Status__c</leftValueReference><operator>EqualTo</operator><rightValue><stringValue>Paid</stringValue></rightValue></conditions><connector><targetReference>Refuse_Paid</targetReference></connector><label>Is paid</label></rules><rules><name>Is_extended</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Find_Latest_Bill.Extended__c</leftValueReference><operator>EqualTo</operator><rightValue><booleanValue>true</booleanValue></rightValue></conditions><connector><targetReference>Refuse_Extended</targetReference></connector><label>Is extended</label></rules><rules><name>Too_overdue</name><conditionLogic>and</conditionLogic><conditions><leftValueReference>Find_Latest_Bill.Days_Overdue__c</leftValueReference><operator>GreaterThan</operator><rightValue><elementReference>MaxDaysOverdue</elementReference></rightValue></conditions><connector><targetReference>Refuse_Too_Overdue</targetReference></connector><label>Too overdue</label></rules></decisions>

<description>Moves the due date of the verified customer's latest bill by ExtensionDays. Refuses if paid, already extended, or more than MaxDaysOverdue days past due.</description>
<environments>Default</environments>
<formulas><name>computedNewDue</name><dataType>Date</dataType><expression>{!Find_Latest_Bill.Due_Date__c} + {!ExtensionDays}</expression></formulas>

<formulas><name>computedStatus</name><dataType>String</dataType><expression>IF({!computedNewDue} &gt;= TODAY(), "Unpaid", "Overdue")</expression></formulas>

<formulas><name>computedStillOverdue</name><dataType>Boolean</dataType><expression>{!computedNewDue} &lt; TODAY()</expression></formulas>

<interviewLabel>Grant Payment Extension {!$Flow.CurrentDateTime}</interviewLabel>
<label>Grant Payment Extension</label>
<processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
<processType>AutoLaunchedFlow</processType>
<recordLookups><name>Find_Latest_Bill</name><label>Find Latest Bill</label><locationX>176</locationX><locationY>300</locationY><assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound><connector><targetReference>Check_Rules</targetReference></connector><faultConnector><targetReference>No_Bill</targetReference></faultConnector><filterLogic>and</filterLogic><filters><field>Contact__c</field><operator>EqualTo</operator><value><elementReference>contactId</elementReference></value></filters><getFirstRecordOnly>true</getFirstRecordOnly><object>Bill__c</object><storeOutputAutomatically>true</storeOutputAutomatically><sortField>Due_Date__c</sortField><sortOrder>Desc</sortOrder></recordLookups>

<recordUpdates><name>Apply_Extension</name><label>Apply Extension</label><locationX>176</locationX><locationY>1350</locationY><connector><targetReference>Set_Granted</targetReference></connector><faultConnector><targetReference>No_Bill</targetReference></faultConnector><filterLogic>and</filterLogic><filters><field>Id</field><operator>EqualTo</operator><value><elementReference>Find_Latest_Bill.Id</elementReference></value></filters><inputAssignments><field>Due_Date__c</field><value><elementReference>computedNewDue</elementReference></value></inputAssignments><inputAssignments><field>Extended__c</field><value><booleanValue>true</booleanValue></value></inputAssignments><inputAssignments><field>Status__c</field><value><elementReference>computedStatus</elementReference></value></inputAssignments><object>Bill__c</object></recordUpdates>

