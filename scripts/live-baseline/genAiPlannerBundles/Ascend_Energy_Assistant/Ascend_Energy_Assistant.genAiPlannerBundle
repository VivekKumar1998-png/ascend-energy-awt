        <fullName>Ascend_Verification_16jgK000002R7kD</fullName>
        <canEscalate>false</canEscalate>
        <description>Customer wants to see their bill, ask about their account, or get a payment extension, and has not been verified yet. Also used when the customer gives an account number and phone number.</description>
        <developerName>Ascend_Verification_16jgK000002R7kD</developerName>
        <genAiPluginInstructions>
            <description>Ask the customer for BOTH their customer account number AND the full phone number registered on the account, in one message.</description>
            <developerName>instruction_1</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_1</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>When you have both, run Verify Customer with exactly what the customer typed. Do not guess or fill in missing digits.</description>
            <developerName>instruction_2</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_2</masterLabel>
            <sortOrder>2</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>If verified is true, greet the customer by first name. If they already asked for their bill or an extension, continue with that straight away; otherwise say what you can do.</description>
            <developerName>instruction_3</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_3</masterLabel>
            <sortOrder>3</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>If verified is false, say only: I couldn&apos;t verify those details. Please check your account number and the full registered phone number and try again. Never say which value was wrong and never give hints.</description>
            <developerName>instruction_4</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_4</masterLabel>
            <sortOrder>4</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Never accept other proof of identity such as an email address, a name or a bill number.</description>
            <developerName>instruction_5</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_5</masterLabel>
            <sortOrder>5</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Never show any account information before verification. Remember the contactId returned by Verify Customer and use only that for later steps.</description>
            <developerName>instruction_6</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_6</masterLabel>
            <sortOrder>6</sortOrder>
        </genAiPluginInstructions>
        <language>en_US</language>
