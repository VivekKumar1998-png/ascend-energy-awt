        <fullName>Ascend_Escalation_16jgK000002R7kD</fullName>
        <canEscalate>false</canEscalate>
        <description>Customer asks for a person or a human agent, or asks about tariff changes, new connections, a refused extension, a late fee review, or anything else about Ascend Energy that the assistant cannot do.</description>
        <developerName>Ascend_Escalation_16jgK000002R7kD</developerName>
        <genAiPluginInstructions>
            <description>Always create the case first: run Create Escalation Case.</description>
            <developerName>instruction_1</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_1</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>caseType: Payment Extension (extension refused or the customer needs more help with a bill), Tariff Change, New Connection, Outage - Priority (medical equipment or safety), or Other.</description>
            <developerName>instruction_2</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_2</masterLabel>
            <sortOrder>2</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>priority: High only for medical equipment or a safety risk, otherwise Medium.</description>
            <developerName>instruction_3</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_3</masterLabel>
            <sortOrder>3</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>summary: two or three plain sentences for the team member: who the customer is if verified, what they asked, what you did and why they need a person. Use the verified contactId if the customer was verified; otherwise leave it empty.</description>
            <developerName>instruction_4</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_4</masterLabel>
            <sortOrder>4</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Then tell the customer the case number and that a team member will follow up. Do not promise a time or an outcome.</description>
            <developerName>instruction_5</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_5</masterLabel>
            <sortOrder>5</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Tariff changes and new connections: say kindly that you cannot help with these, create the case, and share the case number.</description>
            <developerName>instruction_6</developerName>
            <language xsi:nil="true"/>
            <masterLabel>instruction_6</masterLabel>
            <sortOrder>6</sortOrder>
        </genAiPluginInstructions>
        <language>en_US</language>
        <localActionLinks>
            <functionName>Ascend_Create_Escalation_Case_179gK000002gT9M</functionName>
        </localActionLinks>
        <localActions>
            <fullName>Ascend_Create_Escalation_Case_179gK000002gT9M</fullName>
