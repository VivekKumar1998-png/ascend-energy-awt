        <localActions>
            <fullName>Ascend_Grant_Payment_Extension_179gK000002gT9O</fullName>
            <description>Moves the due date of the verified customer&apos;s latest bill 7 days later, once per bill. Refuses if the bill is paid, already extended, or more than 30 days past due. Returns granted, reasonCode, oldDueDate, newDueDate and stillOverdue. The contactId input must be the contactId returned by Verify Customer. Only run after the customer clearly said yes.</description>
            <developerName>Ascend_Grant_Payment_Extension_179gK000002gT9O</developerName>
            <invocationTarget>Grant_Payment_Extension</invocationTarget>
            <invocationTargetType>flow</invocationTargetType>
            <isConfirmationRequired>false</isConfirmationRequired>
            <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
            <localDeveloperName>Ascend_Grant_Payment_Extension</localDeveloperName>
